# ============================================================
#  DocuMind — environment variables (ALL FREE / FREE-TIER)
#  Copy to .env (in this folder) and fill in. NEVER commit real keys.
#  DocuMind is fully self-contained; it needs no files outside this folder.
# ============================================================

# --- LLM providers (free) — needed for /ask answer generation & RAGAS eval ---
# Groq free tier (no card): https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio key, billing DISABLED: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=   # LiteLLM reads Gemini via this name too

# --- Model routing (override if a model id is deprecated) ---
PRIMARY_MODEL=groq/openai/gpt-oss-120b
FALLBACK_MODEL=gemini/gemini-3.5-flash
# Small/fast model for follow-up query rewriting + per-doc summaries
REWRITE_MODEL=groq/openai/gpt-oss-20b

# --- Observability: Langfuse (optional; free cloud tier or self-host) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Vector store: Qdrant (local docker, free) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
DOCUMIND_COLLECTION=documind_chunks

# --- Local models (downloaded from HuggingFace, run on CPU, zero cost) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Chunking / API ---
CHUNK_TOKENS=256
DOCUMIND_API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
